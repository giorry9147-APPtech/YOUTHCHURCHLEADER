# Firebase web app config — kopieer dit bestand naar .env.local en vul je waardes in.
# Deze waarden zijn publiek (Firebase apiKey is geen geheim) maar horen niet in code.
# Vind ze in: Firebase Console → Project Settings → "Your apps" → de web app config blok.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
