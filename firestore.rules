// Firestore security rules — Leaders in Purpose
// MVP rules: open read/write while we don't have auth yet.
// REPLACE WITH PROPER AUTH-BASED RULES BEFORE GOING PUBLIC.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // While in development without auth, allow all reads + writes.
    // Lock this down after wiring authentication.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
